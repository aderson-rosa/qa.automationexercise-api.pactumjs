{
  "name": "qa.automationexercise-api.pactumjs",
  "version": "1.0.0",
  "description": "Testes de API do ServeRest com PactumJS, Joi (contrato) e Allure Reports",
  "private": true,
  "scripts": {
    "test": "mocha",
    "test:login": "mocha --grep @login",
    "test:usuarios": "mocha --grep @usuarios",
    "test:produtos": "mocha --grep @produtos",
    "typecheck": "tsc --noEmit",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.5.0",
    "allure-commandline": "^2.43.0",
    "allure-mocha": "^3.11.1",
    "joi": "^17.13.3",
    "mocha": "^10.7.3",
    "mocha-multi-reporters": "^1.5.1",
    "pactum": "^3.7.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
